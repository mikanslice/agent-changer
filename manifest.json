{
    "manifest_version": 3,
    "name": "Agent Changer",
    "version": "0.0.1",
    "description": "Change agent at specific page",
    "icons": {
        "48": "images/icon-48.png",
        "128": "images/icon-128.png"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": "images/icon-128.png"
    },
    "permissions": [
        "declarativeNetRequest"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "host_permissions": [
        "<all_urls>"
    ]
}